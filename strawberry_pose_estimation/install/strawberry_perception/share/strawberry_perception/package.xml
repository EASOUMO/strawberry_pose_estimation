<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>strawberry_perception</name>
  <version>0.1.0</version>
  <description>
    Strawberry detection and picking-point localisation node.
    Implements the composite YOLOv5s + YOLOv5s-seg pipeline from
    Xie et al. (2024) "Development, Integration, and Field Evaluation of a
    Dual-Arm Ridge Cultivation Strawberry Autonomous Harvesting Robot",
    Journal of Field Robotics.
  </description>

  <maintainer email="harvestbot@example.com">HarvestBot</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Python library dependencies (installed via pip) -->
  <!-- ultralytics – YOLOv5 / YOLOv8 inference  (pip install ultralytics)  -->
  <!-- scipy       – Rotation class for quaternion math                      -->
  <!-- numpy, opencv-python – standard vision deps                           -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
